#include<stdio.h>
int main()
{
int tea_quantity = 3;
int samosa_quantity = 4;
int roll_quantity = 2;

double tea_price = 60.00;
double samosa_price = 40.50;
double roll_price = 120.00;
double tea_subtotal;
double samosa_subtotal;
double roll_subtotal;
double bill_subtotal;
double gst;
double grand_total;
tea_subtotal = tea_quantity * tea_price;
samosa_subtotal = samosa_quantity * samosa_price;
roll_subtotal = roll_quantity * roll_price;

bill_subtotal = tea_subtotal + samosa_subtotal + roll_subtotal;
gst = 0.16 * bill_subtotal;
grand_total = bill_subtotal + gst;
printf("================================================= FAST CAFETERIA RECEIPT ====================================\n");
printf("Item          Qty Unit Price (PKR)            Subtotal (PKR)\n");
printf("---------------------------------------------------------------------------------------------------------\n");
printf("Tea                    %d%.2f                                 %.2f\n",                            tea_quantity, tea_price, tea_subtotal);
printf("Samosa                 %d%.2f                                 %.2f\n",                            samosa_quantity, samosa_price, samosa_subtotal);
printf("Chicken Roll           %d%.2f                                 %.2f\n",                            roll_quantity, roll_price, roll_subtotal);
printf("-----------------------------------------------------------------------------------------------------------------\n");
printf("Subtotal:              PKR  %.2f\n", bill_subtotal);
printf("GST (16%%):            PKR  %.2f\n", grand_total);
printf("============================================= THANK YOU FOR YOUR VISIT ===========================================\n");
return 0;
}
