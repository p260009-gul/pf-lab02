#include<stdio.h>
int main()
{
double basic_salary = 85000.00;
double hra, ma, gross_salary, tax, net_salary;
hra = 0.20 * basic_salary;
ma = 0.10 * basic_salary;
gross_salary = basic_salary + hra +ma;
tax = 0.05 *gross_salary;
net_salary = gross_salary - tax;
printf("========================== MONTHLYSALARY SLIP ========================\n");
printf("Basic Salary:PKR %.2f\n",basic_salary);
printf("House Rent Allowance (20%%):      PKR %.2f\n",hra);
printf("Medical Allowance (10%%):PKR %.2f\n", ma);
printf("-----------------------------------------------------------------------------\n");
printf("Gross SAlary:PKR %.2f\n", gross_salary);
printf("Tax Deduction (5%%):PKR %.2f\n", tax);
printf("------------------------------------------------------------------------------\n");
printf("Net Payable Salary:PKR %.2f", net_salary);
printf("==================================================================================\n");
return 0;
}
